<?xml version="1.0"?>
<ruleset name="ShackLocations">
    <description>PSR-12, allowing a blank line before a closing brace (house style before } else)</description>

    <file>src</file>
    <file>tests</file>

    <exclude-pattern>tests/vendor/*</exclude-pattern>
    <exclude-pattern>tests/_output/*</exclude-pattern>
    <exclude-pattern>tests/Support/_generated/*</exclude-pattern>

    <arg name="extensions" value="php"/>

    <rule ref="PSR12">
        <exclude name="Squiz.WhiteSpace.ControlStructureSpacing.SpacingBeforeClose"/>
    </rule>
</ruleset>
